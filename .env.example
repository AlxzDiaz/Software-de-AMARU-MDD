# ─────────────────────────────────────────────────────────────
# AMARU-MDD — Variables de entorno (plantilla)
# Copia este archivo como .env y reemplaza los valores.
# NUNCA subas el archivo .env al repositorio.
#
# Principio: aquí solo va infraestructura y secretos.
# Las reglas de negocio (tasa de comisión, % de reembolso parcial,
# mínimo de fotos, plazo de preparación) NO van aquí: viven en la
# base de datos o en packages/shared/src/constants.
# ─────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────
NODE_ENV=development
TZ=America/Lima
WEB_URL=http://localhost:5173
API_URL=http://localhost:3000
API_PORT=3000
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=debug

# ── Base de datos (PostgreSQL) ───────────────────────────────
POSTGRES_USER=amaru
POSTGRES_PASSWORD=cambiar_en_local
POSTGRES_DB=amaru_mdd
POSTGRES_PORT=5432
DATABASE_URL=postgresql://amaru:cambiar_en_local@localhost:5432/amaru_mdd?schema=public
DATABASE_URL_TEST=postgresql://amaru:cambiar_en_local@localhost:5432/amaru_mdd_test?schema=public

# ── Autenticación ────────────────────────────────────────────
# Genera secretos con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECRET=
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

# ── Límite de peticiones ─────────────────────────────────────
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=10

# ── Pagos (Fase 7) ───────────────────────────────────────────
# mock = pasarela simulada de desarrollo. No hay proveedor real configurado todavía.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_HOLD_MINUTES=20

# ── Correo ───────────────────────────────────────────────────
# En desarrollo, Mailpit captura todos los correos (http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="AMARU-MDD <no-reply@amaru.local>"

# ── Almacenamiento de archivos ───────────────────────────────
# local | s3  (MinIO en desarrollo es compatible con S3)
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_PUBLIC=amaru-public
S3_BUCKET_PRIVATE=amaru-private
S3_PUBLIC_BASE_URL=http://localhost:9000/amaru-public
SIGNED_URL_TTL_SECONDS=300
STORAGE_LOCAL_PATH=./storage

# ── Logística (Fase 8) ───────────────────────────────────────
# manual = el artesano o admin registra operador y número de seguimiento
LOGISTICS_PROVIDER=manual

# ── Seed de desarrollo ───────────────────────────────────────
# Solo se usa al poblar una BD vacía; después se administra desde el panel.
SEED_ADMIN_EMAIL=admin@amaru.local
SEED_ADMIN_PASSWORD=
SEED_COMMISSION_RATE_BPS=
SEED_PARTIAL_REFUND_PERCENT=

# ── Frontend (Vite: solo variables públicas con prefijo VITE_) ─
VITE_API_URL=http://localhost:3000/api
VITE_SITE_URL=http://localhost:5173
